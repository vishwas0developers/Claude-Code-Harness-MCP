{
  "name": "claude-code-harness-mcp",
  "version": "0.1.2",
  "description": "MCP server that routes functionality/backend/logic tasks from any AI coding agent to a local Claude Code session, while the host agent keeps doing design/UI work itself.",
  "main": "dist/src/server.js",
  "bin": {
    "claude-code-harness-mcp": "dist/cli/index.js"
  },
  "files": [
    "dist/cli",
    "dist/install",
    "dist/src",
    "!dist/src/test"
  ],
  "type": "commonjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manrajidevi91/claude-code-harness-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "ai-agent",
    "antigravity",
    "cursor",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "pretest": "npm run build",
    "test": "node --test dist/src/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.4.2"
  }
}
